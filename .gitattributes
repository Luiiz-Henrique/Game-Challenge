# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# --- Git LFS Tracking (Assets) ---
#
# O macro `binary` (= -diff -merge -text) e OBRIGATORIO nas regras de LFS.
# Sem ele o Git mescla TEXTUALMENTE um ponteiro LFS (3 linhas) com o
# arquivo real (um SVG de 186 linhas) e injeta marcadores "<<<<<<<"
# DENTRO do asset -- foi o que aconteceu com os SVGs deste repo.
#
# `diff=lfs` e `merge=lfs` nao resolvem: apontam para drivers inexistentes
# no config (o `git lfs install` so cria filter.lfs.clean/smudge/process).
# Trade-off: o diff deixa de pre-visualizar a imagem inline.

# 3D Models
*.fbx filter=lfs binary
*.gltf filter=lfs binary
*.glb filter=lfs binary
*.blend filter=lfs binary
*.obj filter=lfs binary

# Images
*.png filter=lfs binary
*.svg filter=lfs binary
*.jpg filter=lfs binary
*.jpeg filter=lfs binary
*.gif filter=lfs binary
*.tga filter=lfs binary
*.webp filter=lfs binary
*.exr filter=lfs binary
*.hdr filter=lfs binary
*.dds filter=lfs binary

# Audio
*.mp3 filter=lfs binary
*.wav filter=lfs binary
*.ogg filter=lfs binary

# Font & Icon
*.ttf filter=lfs binary
*.otf filter=lfs binary
*.ico filter=lfs binary

# Godot LFS Specific
# .scn = cena BINARIA do Godot 3 -> pode ir pro LFS.
# .tscn/.tres sao TEXTO e ficam DE FORA do LFS de proposito: sao os
# arquivos mais mergeados do projeto e precisam de diff/merge legiveis.
*.scn filter=lfs binary
*.res filter=lfs binary
*.material filter=lfs binary
*.anim filter=lfs binary
*.mesh filter=lfs binary
*.lmbake filter=lfs binary
